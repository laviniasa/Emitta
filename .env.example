# simulacao | homologacao | producao
NFSE_AMBIENTE=simulacao

# Arquivo do banco SQLite
NFSE_BANCO=dados/emissor.db

# Pasta com os certificados A1 (<CNPJ>.pfx)
NFSE_PASTA_CERTIFICADOS=certificados

# Pasta com os XSDs oficiais (opcional; se definida, valida o XML antes de enviar)
# NFSE_PASTA_XSD=xsd

# Senha de cada certificado: CERT_SENHA_<CNPJ>
# CERT_SENHA_11222333000181=sua-senha

# Código pedido uma única vez para criar a primeira conta de contador
EMITTA_CODIGO_INSTALACAO=troque-por-um-codigo-longo-e-secreto

# Só para rodar localmente sem HTTPS (modo simulação)
EMITTA_COOKIE_SEGURO=0

# Chave que criptografa os certificados guardados (gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
EMITTA_CHAVE_CERTIFICADOS=
